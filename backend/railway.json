{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "preDeployCommand": ["python manage.py migrate --noinput && python manage.py seed --online"],
    "startCommand": "gunicorn config.wsgi --bind 0.0.0.0:$PORT --workers 2 --timeout 60",
    "restartPolicyType": "ON_FAILURE"
  }
}
